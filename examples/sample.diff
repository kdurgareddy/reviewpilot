+export async function loadReceipts(ids: string[]) {
+  const out = [];
+  for (const id of ids) {
+    const r = await fetch(`/api/receipts/${id}`);
+    out.push(await r.json());
+  }
+  return out;
+}
+
+export function renderNote(el: HTMLElement, note: string) {
+  if (note == "") return;
+  el.innerHTML = note;
+}
